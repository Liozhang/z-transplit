# npm 10.9.2 (the version on the machine that scaffolded this repo) crashes
# while building the ideal tree from scratch:
#   TypeError: Cannot read properties of null (reading 'edgesOut')
#   at #loadPeerSet (arborist/build-ideal-tree.js)
# The crash is deterministic and reproducible in a clean directory with an empty
# cache; it is triggered by vitest@4's optional peer set
# (@vitest/browser-*, @vitejs/devtools). Running with --legacy-peer-deps
# installs the same 144 packages and typechecks + tests cleanly.
# Remove this file once the repo is installed with npm >= 11.
legacy-peer-deps=true
